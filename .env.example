# jira-xray-cloud-mcp – environment configuration
# Copy to .env and adjust. Changes require a devcontainer rebuild.

# Where the Xray API key comes from:
#   env     - XRAY_CLIENT_ID / XRAY_CLIENT_SECRET below, one key for the whole server
#   headers - every HTTP request sends X-Xray-Client-Id / X-Xray-Client-Secret (HTTP transport,
#             serve over HTTPS only); the two variables below are ignored
XRAY_AUTH_MODE=env

# Xray API key (Xray > Global Settings > API Keys). Calls run as the key's Jira user.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Regional hosts: https://us.xray.cloud.getxray.app, https://eu.xray.cloud.getxray.app,
# https://au.xray.cloud.getxray.app
XRAY_BASE_URL=https://xray.cloud.getxray.app

# true = only read tools are registered (write tools do not exist on the server).
XRAY_READ_ONLY=false

# Toolsets to enable, comma separated, applied left to right. Every toolset has a read half
# (<name>_read) and, if it has write tools, a write half (<name>_write).
#   default | all | <name> (both halves) | <name>_read | <name>_write | * wildcards | -<token>
# Names: tests, preconditions, test_sets, test_plans, test_executions, test_runs,
#        test_repository, coverage, history, settings, imports, attachments, backup (opt-in), graphql
# Examples: XRAY_TOOLSETS=default,backup,-graphql
#           XRAY_TOOLSETS=*_read,test_runs_write
XRAY_TOOLSETS=default

# Single tools added to (<tool>) or removed from (-<tool>) the toolset selection, left to right,
# * wildcards allowed. XRAY_READ_ONLY=true still removes every write tool.
# Example: XRAY_TOOLS=-xray_delete_*,xray_get_test_run
XRAY_TOOLS=

# HTTP timeout (seconds) and largest file returned inline by download/export tools (bytes).
XRAY_TIMEOUT=60
XRAY_MAX_DOWNLOAD_BYTES=10485760
